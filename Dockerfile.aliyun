# AI 商品搬运工具(NocoBase v2 fork)生产镜像:fork 源码全量构建。
# 适用:阿里云 ACR 云构建(构建规则 Dockerfile 文件名填 Dockerfile.aliyun)或服务器本地 docker build。
# 注意:仓库根目录的 Dockerfile 是 NocoBase 官方发布流水线专用(依赖内部 verdaccio),不能直接构建本 fork。
FROM node:22-bookworm
WORKDIR /app/nocobase

# 跳过浏览器/预编译二进制下载(构建用不到,且网络环境下易失败)
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PUPPETEER_SKIP_DOWNLOAD=1 \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1 \
    CYPRESS_INSTALL_BINARY=0 \
    ELECTRON_SKIP_BINARY_DOWNLOAD=1 \
    APP_ENV=production

COPY . .

# npmmirror 国内外都可达;完整 monorepo 依赖安装约 5-10 分钟
RUN yarn config set registry https://registry.npmmirror.com -g && \
    yarn config set network-timeout 600000 -g && \
    yarn install --network-concurrency 8

# 全量生产构建(core + 插件 + 客户端);构建机建议 ≥8G 内存
RUN NODE_OPTIONS=--max-old-space-size=6144 yarn build

EXPOSE 13000
CMD ["yarn", "start"]
